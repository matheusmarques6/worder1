<!-- Worder Tracking — App Embed Block -->
<!-- Injected automatically on ALL pages of the theme -->
<!-- Merchant activates in: Online Store > Themes > Customize > App Embeds > Worder Tracking -->

<script>
  window.__worder = window.__worder || {};
  window.__worder.config = {
    accountId: {{ block.settings.account_id | json }},
    storeId: {{ block.settings.store_id | json }},
    endpoint: {{ block.settings.tracking_endpoint | json }},
    shopDomain: {{ shop.permanent_domain | json }},
  };

  // === AUTOMATIC IDENTIFICATION ===

  // 1. Logged-in Shopify customer → identify by email
  {% if customer %}
    window.__worder.customer = {
      email: {{ customer.email | json }},
      firstName: {{ customer.first_name | json }},
      lastName: {{ customer.last_name | json }},
      phone: {{ customer.phone | json }},
      shopifyCustomerId: {{ customer.id | json }},
      ordersCount: {{ customer.orders_count | json }},
      totalSpent: {{ customer.total_spent | json }},
      tags: {{ customer.tags | json }},
      acceptsMarketing: {{ customer.accepts_marketing | json }},
    };
  {% endif %}

  // 2. Product data (if on a product page)
  {% if template contains 'product' and product %}
    window.__worder.product = {
      id: {{ product.id | json }},
      title: {{ product.title | json }},
      handle: {{ product.handle | json }},
      vendor: {{ product.vendor | json }},
      type: {{ product.type | json }},
      price: {{ product.price | money_without_currency | json }},
      compareAtPrice: {{ product.compare_at_price | money_without_currency | json }},
      url: {{ product.url | json }},
      imageUrl: {{ product.featured_image | image_url: width: 600 | json }},
      tags: {{ product.tags | json }},
      available: {{ product.available | json }},
      selectedVariantId: {{ product.selected_or_first_available_variant.id | json }},
      selectedVariantTitle: {{ product.selected_or_first_available_variant.title | json }},
      sku: {{ product.selected_or_first_available_variant.sku | json }},
    };
  {% endif %}

  // 3. Collection data (if on a collection page)
  {% if template contains 'collection' and collection %}
    window.__worder.collection = {
      id: {{ collection.id | json }},
      title: {{ collection.title | json }},
      handle: {{ collection.handle | json }},
      url: {{ collection.url | json }},
      productsCount: {{ collection.products_count | json }},
    };
  {% endif %}

  // 4. Current template (to know which page type we're on)
  window.__worder.template = {{ template | json }};
  window.__worder.pageTitle = {{ page_title | json }};
</script>

<!-- Load tracking script (async, doesn't block rendering) -->
<script src="{{ 'worder.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Worder Tracking",
  "target": "body",
  "settings": [
    {
      "type": "text",
      "id": "account_id",
      "label": "Account ID",
      "info": "Filled automatically. Do not change."
    },
    {
      "type": "text",
      "id": "store_id",
      "label": "Store ID",
      "info": "Filled automatically. Do not change."
    },
    {
      "type": "text",
      "id": "tracking_endpoint",
      "label": "Tracking Endpoint",
      "default": "https://app.worder.com/api/track"
    }
  ]
}
{% endschema %}
