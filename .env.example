# Outbound webhooks: 32-byte key (base64) for at-rest secret encryption
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

# =====================================================
# WORDER AI MODULE
# =====================================================
# LLM Providers
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# Redis (Upstash) — buffer/lock
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# QStash — delays/idempotency
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Buffer/timing
AI_BUFFER_DEBOUNCE_MS=5000
AI_BUFFER_MAX_TTL_MS=30000
AI_TYPING_MIN_MS=1500
AI_TYPING_MAX_MS=4000

# Multi-modal (F2+)
WHISPER_MODEL=whisper-1
GEMINI_API_KEY=

# Cost caps (F3+)
AI_DAILY_TOKEN_LIMIT_PER_ORG=1000000
AI_MONTHLY_USD_LIMIT_PER_ORG=500
