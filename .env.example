# Outbound webhooks: 32-byte key (base64) for at-rest secret encryption
# Generate with: openssl rand -base64 32
WEBHOOK_SECRET_ENCRYPTION_KEY=

# CDN host for email images (production: cdn.worder.email). Every image
# URL the app hands out — media library, editor uploads, outbound
# email HTML — is built on this host, never on <project>.supabase.co.
# The host must be a Cloudflare-proxied CNAME pointing at the Supabase
# project so requests are cached at the Cloudflare edge before reaching
# Supabase. Leave empty only in local development (falls back to the
# Supabase host).
CDN_IMAGES_DOMAIN=

# ============================================
# WhatsApp Cloud API (Sprint 1)
# ============================================

# Meta app credentials (App Dashboard → Basic settings)
META_APP_ID=
META_APP_SECRET=

# OAuth state signing secret (server only). Falls back to NEXTAUTH_SECRET;
# OAuth generation and validation require one of these secrets in every environment.
OAUTH_STATE_SECRET=

# Optional global fallback for webhook verify token (used when a WABA
# was provisioned outside the standard flow). Each account also has a
# per-WABA token in whatsapp_business_accounts.webhook_verify_token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# AES-256-GCM key for at-rest token encryption (whatsapp + tiktok).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Canary flag for the async webhook ingestor. When 'true', the public
# webhook returns 200 in <50ms and the heavy work runs on the QStash
# worker at /api/workers/whatsapp-webhook. When unset/false, the legacy
# synchronous path is used (used to revert without redeploy).
ENABLE_ASYNC_WEBHOOK=

# Used by /api/cron/reprocess-whatsapp-pending and other Vercel crons.
# Set as a long random secret in production; Vercel sends it as
# `Authorization: Bearer ${CRON_SECRET}`.
CRON_SECRET=

# Secret para rotas internas server-to-server (process/document).
# Fallback: CRON_SECRET. Em produção sem nenhuma das duas, a rota responde 401
# e a ingestão de fontes (indexação RAG) para.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Secret para rotas de debug/diagnóstico (src/lib/debug-guard.ts — ex.:
# /api/ai/test, /api/debug/*, /api/analytics/shopify/diagnostico*).
# Exigido em QUALQUER ambiente, inclusive dev (item 43, fix round 1): sem
# secret configurado, a rota responde 404 sempre. Algumas dessas rotas
# aceitam `organizationId` no corpo da requisição — o secret é a ÚNICA
# fronteira de tenancy nelas.
# Generate with: openssl rand -hex 32
DEBUG_ENDPOINT_SECRET=

# ============================================
# Upstash QStash (used by async webhook + automations)
# ============================================
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ============================================
# Upstash Redis (rate limiting, caching, template cache)
# ============================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# Supabase
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================
# App URL (used by QStash callbacks, auth redirects, webhook URLs)
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Host dos links dentro dos e-mails (cliques, aberturas, descadastro,
# confirmação de opt-in). É o padrão da plataforma: o lojista pode
# sobrescrever com o domínio dele em Configurações → E-mail.
#
# ATENÇÃO — este subdomínio tem de apontar para o APP (CNAME para o
# Worder) e NÃO pode ser o mesmo que o provedor de envio usa como
# domínio de rastreamento dele (no Resend: Domains → Configuration →
# "Enable tracking metrics"). São dois redirecionadores diferentes no
# mesmo caminho: quem atende no subdomínio do Resend é o Resend, que não
# conhece /api/t/c/… e responde 400 — resultado, TODO clique de TODO
# e-mail cai numa página de erro, sem nenhum aviso do lado do envio.
#
# Ou seja: se click.worder.email já está no Resend, o nosso tem de ser
# outro (link.worder.email, go.worder.email, click.worder.com.br…),
# apontado para o app e adicionado como domínio do projeto.
#
# Sem esta variável, os links saem no host do painel (app.worder.com.br),
# que é o que os filtros leem como "e-mail encaminhado por intermediário"
# quando o remetente é o domínio da loja. Funciona, mas é o pior dos
# mundos bons.
#
# O app confere sozinho: sonda /api/t/ping no host configurado, avisa no
# painel de saúde de envio quando não é o Worder que atende, e passa a
# montar os links pelo domínio do app até o CNAME ser corrigido.
EMAIL_TRACKING_DOMAIN=link.worder.email

# ============================================
# AI Budget (Task 15 — P1)
# ============================================
# Limite mensal padrão (USD) para orgs sem linha em ai_budgets.
# Orgs que legitimamente gastam mais de $50/mês precisam de linha
# própria na tabela ai_budgets (deploy checklist).
# Padrão: 50 (USD/mês) quando não definido.
DEFAULT_MONTHLY_LIMIT_USD=50

# ============================================
# Motor de IA — runtime de agentes (Python) e copiloto do inbox
# ============================================

# URL pública do runtime de agentes (Render/VPS — ver runtime/DEPLOY.md).
# Sem ela OU sem AGENTS_PREVIEW_TOKEN, POST /api/ai/preview-prompt responde 503
# (src/app/api/ai/preview-prompt/route.ts:18-27) e o botão de preview de prompt
# do hub morre. Não afeta o atendimento: o runtime lê a fila pelo Postgres.
AGENTS_RUNTIME_URL=

# Token de serviço do preview de prompts. O MESMO valor tem de estar no runtime
# (runtime/DEPLOY.md, render.yaml, runtime/.env.piloto.example e
# runtime/.env.bancada.example) — aqui é o lado Vercel do par. Fica só no
# servidor; o browser nunca o vê.
AGENTS_PREVIEW_TOKEN=

# Chave da OpenAI do COPILOTO DO INBOX — não do agente.
# Único leitor vivo: callOpenAI, em src/lib/services/whatsapp/ai-chatbot-service.ts;
# sem ela o copiloto lança 'OPENAI_API_KEY not configured'.
# O agente do WhatsApp NÃO usa esta chave: ele lê organization_api_keys (BYO), e
# os embeddings do RAG tiveram a leitura por env REMOVIDA de propósito — o
# cabeçalho de src/lib/ai/embedding-key.ts diz "SEM fallback pra env".
# Não trate esta env como "a chave da IA".
OPENAI_API_KEY=

# Webhook do Slack para os alertas de WhatsApp. Ausente = DEGRADAÇÃO SILENCIOSA:
# o alerta continua sendo gravado em whatsapp_alerts (o insert de sendAlert, em
# src/lib/whatsapp/alerts.ts) e simplesmente não vai para o Slack — o
# `if (slackUrl)` de src/lib/whatsapp/alerts.ts:61. Ninguém é avisado de que o
# canal ficou mudo; é a única das quatro cuja ausência não aparece em lugar nenhum.
SLACK_WEBHOOK_URL=

# Janela de agrupamento de rajada da IA, em segundos. Default 8.
# SÓ VALE PARA ORG EM MODO LEGADO. A leitura é o AI_DEBOUNCE_SECONDS de
# src/lib/whatsapp/webhook-processor.ts, e o único consumo em caminho de
# produção está dentro do `if (runtimeMode === 'legacy' && …)` de
# src/lib/whatsapp/webhook-processor.ts:569. (A rota de debug
# src/app/api/ai/test/cloud-webhook/route.ts:208 lê a mesma env, fora do
# caminho de atendimento.)
# Org migrada ao runtime (linha em ai_runtime_rollout) lê a janela POR
# ORGANIZAÇÃO, de ai_agents.settings.delivery.debounce_seconds, via
# getDeliveryDebounceSeconds — clamp [3,60] e default 8 em sanitizeDelivery
# (src/lib/ai/agent-hub.ts) — e ignora esta env por inteiro. Não é knob global.
# Cuidado: `Number(...) || 8` engole o zero — WHATSAPP_AI_DEBOUNCE_SECONDS=0 dá 8s.
WHATSAPP_AI_DEBOUNCE_SECONDS=

# Domínio compartilhado de envio (padrão: worder.email). Toda loja nasce
# com um endereço nele; campanha em massa exige o domínio do lojista.
# SHARED_SENDER_DOMAIN=worder.email
# Quantos e-mails de campanha cada loja pode mandar pelo endereço
# temporário em 30 dias antes de precisar verificar o domínio dela.
# SHARED_DOMAIN_CAMPAIGN_ALLOWANCE=1000
