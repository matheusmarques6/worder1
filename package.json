{
  "name": "worder",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci-policy": "node --test scripts/ci/*.test.mjs",
    "test:ai:parity": "vitest run src/lib/ai/__tests__/hub-configuration-parity.test.ts src/lib/ai/__tests__/hub-runtime-parity.test.ts",
    "test:ai:api": "vitest run src/app/api/ai",
    "test:ai:ui": "playwright test --config playwright.ai.config.ts",
    "test:ai:preflight": "node scripts/ci/ai-e2e-preflight.mjs",
    "test:ai:journeys": "playwright test --config playwright.ai-e2e.config.ts",
    "worker:dev": "npx ts-node --project worker/tsconfig.json worker/campaign-worker.ts",
    "worker:build": "cd worker && npm run build",
    "worker:start": "cd worker && npm start",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "schema:snapshot": "node scripts/schema-snapshot.mjs"
  },
  "dependencies": {
