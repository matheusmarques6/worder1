{
  "version": "3.0",
  "data_api_version": "3.0",
  "routing_model": {
    "CART_REMINDER": ["FEEDBACK"],
    "FEEDBACK": ["THANK_YOU"],
    "THANK_YOU": []
  },
  "screens": [
    {
      "id": "CART_REMINDER",
      "title": "Carrinho Abandonado",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Voce esqueceu itens no carrinho!"
          },
          {
            "type": "TextSubheading",
            "text": "Seus produtos ainda estao esperando por voce."
          },
          {
            "type": "Image",
            "src": "${data.product_image_url}",
            "width": 300,
            "height": 200,
            "alt-text": "Produto no carrinho"
          },
          {
            "type": "TextBody",
            "text": "${data.product_name} — R$ ${data.product_price}"
          },
          {
            "type": "TextCaption",
            "text": "Finalize sua compra e receba frete gratis!"
          },
          {
            "type": "Footer",
            "label": "Ver motivos",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "FEEDBACK"
              },
              "payload": {
                "screen_source": "CART_REMINDER"
              }
            }
          }
        ]
      },
      "data": {
        "product_image_url": {
          "type": "string",
          "__example__": "https://example.com/product.jpg"
        },
        "product_name": {
          "type": "string",
          "__example__": "Camiseta Premium"
        },
        "product_price": {
          "type": "string",
          "__example__": "89,90"
        }
      }
    },
    {
      "id": "FEEDBACK",
      "title": "Nos conte o motivo",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Por que nao finalizou a compra?"
          },
          {
            "type": "TextBody",
            "text": "Sua resposta nos ajuda a melhorar sua experiencia."
          },
          {
            "type": "RadioButtonsGroup",
            "name": "abandonment_reason",
            "label": "Selecione o motivo",
            "required": true,
            "data-source": [
              { "id": "price", "title": "Preco muito alto" },
              { "id": "shipping", "title": "Frete caro ou demorado" },
              { "id": "changed_mind", "title": "Mudei de ideia" },
              { "id": "other", "title": "Outro motivo" }
            ]
          },
          {
            "type": "Footer",
            "label": "Enviar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "abandonment_reason": "${form.abandonment_reason}",
                "screen_source": "FEEDBACK"
              }
            }
          }
        ]
      }
    },
    {
      "id": "THANK_YOU",
      "title": "Obrigado!",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Obrigado pelo feedback!"
          },
          {
            "type": "TextBody",
            "text": "Agradecemos por compartilhar sua opiniao. Estamos sempre trabalhando para melhorar."
          },
          {
            "type": "TextBody",
            "text": "${data.coupon_message}"
          },
          {
            "type": "Footer",
            "label": "Voltar a loja",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "abandonment_reason": "${data.abandonment_reason}",
                "flow_completed": true
              }
            }
          }
        ]
      },
      "data": {
        "abandonment_reason": {
          "type": "string",
          "__example__": "price"
        },
        "coupon_message": {
          "type": "string",
          "__example__": "Use o cupom VOLTA10 para 10% de desconto!"
        }
      }
    }
  ]
}
