{
  "version": "3.0",
  "data_api_version": "3.0",
  "routing_model": {
    "DATE_PICKER": ["TIME_SLOT"],
    "TIME_SLOT": ["CONFIRMATION"],
    "CONFIRMATION": []
  },
  "screens": [
    {
      "id": "DATE_PICKER",
      "title": "Agendar Horario",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Escolha a data"
          },
          {
            "type": "TextBody",
            "text": "Selecione a data desejada para seu agendamento em ${data.business_name}."
          },
          {
            "type": "DatePicker",
            "name": "appointment_date",
            "label": "Data do agendamento",
            "required": true,
            "min-date": "${data.min_date}",
            "max-date": "${data.max_date}",
            "helper-text": "Disponivel de segunda a sabado"
          },
          {
            "type": "Footer",
            "label": "Escolher horario",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "appointment_date": "${form.appointment_date}",
                "screen_source": "DATE_PICKER"
              }
            }
          }
        ]
      },
      "data": {
        "business_name": {
          "type": "string",
          "__example__": "Clinica Saude"
        },
        "min_date": {
          "type": "string",
          "__example__": "1717200000000"
        },
        "max_date": {
          "type": "string",
          "__example__": "1719792000000"
        }
      }
    },
    {
      "id": "TIME_SLOT",
      "title": "Escolha o Horario",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Horarios disponiveis"
          },
          {
            "type": "TextBody",
            "text": "Data selecionada: ${data.formatted_date}"
          },
          {
            "type": "Dropdown",
            "name": "time_slot",
            "label": "Horario",
            "required": true,
            "data-source": "${data.available_slots}"
          },
          {
            "type": "Footer",
            "label": "Confirmar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "appointment_date": "${data.appointment_date}",
                "time_slot": "${form.time_slot}",
                "screen_source": "TIME_SLOT"
              }
            }
          }
        ]
      },
      "data": {
        "appointment_date": {
          "type": "string",
          "__example__": "2026-06-15"
        },
        "formatted_date": {
          "type": "string",
          "__example__": "15 de junho de 2026"
        },
        "available_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "09:00", "title": "09:00" },
            { "id": "10:00", "title": "10:00" },
            { "id": "11:00", "title": "11:00" },
            { "id": "14:00", "title": "14:00" },
            { "id": "15:00", "title": "15:00" },
            { "id": "16:00", "title": "16:00" }
          ]
        }
      }
    },
    {
      "id": "CONFIRMATION",
      "title": "Confirmacao",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Agendamento Confirmado!"
          },
          {
            "type": "TextBody",
            "text": "Seu agendamento foi realizado com sucesso."
          },
          {
            "type": "TextSubheading",
            "text": "Resumo"
          },
          {
            "type": "TextBody",
            "text": "Data: ${data.formatted_date}"
          },
          {
            "type": "TextBody",
            "text": "Horario: ${data.time_slot}"
          },
          {
            "type": "TextBody",
            "text": "Local: ${data.business_name}"
          },
          {
            "type": "TextCaption",
            "text": "Voce recebera uma mensagem de lembrete 24h antes do agendamento."
          },
          {
            "type": "Footer",
            "label": "Fechar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "appointment_date": "${data.appointment_date}",
                "time_slot": "${data.time_slot}",
                "flow_completed": true
              }
            }
          }
        ]
      },
      "data": {
        "appointment_date": {
          "type": "string",
          "__example__": "2026-06-15"
        },
        "formatted_date": {
          "type": "string",
          "__example__": "15 de junho de 2026"
        },
        "time_slot": {
          "type": "string",
          "__example__": "14:00"
        },
        "business_name": {
          "type": "string",
          "__example__": "Clinica Saude"
        }
      }
    }
  ]
}
