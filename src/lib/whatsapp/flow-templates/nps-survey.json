{
  "version": "3.0",
  "data_api_version": "3.0",
  "routing_model": {
    "NPS_SCORE": ["COMMENT"],
    "COMMENT": ["THANK_YOU"],
    "THANK_YOU": []
  },
  "screens": [
    {
      "id": "NPS_SCORE",
      "title": "Pesquisa de Satisfacao",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Como foi sua experiencia?"
          },
          {
            "type": "TextBody",
            "text": "De 0 a 10, qual a probabilidade de voce recomendar a ${data.company_name} para um amigo?"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "nps_score",
            "label": "Sua nota",
            "required": true,
            "data-source": [
              { "id": "0", "title": "0 — Nada provavel" },
              { "id": "1", "title": "1" },
              { "id": "2", "title": "2" },
              { "id": "3", "title": "3" },
              { "id": "4", "title": "4" },
              { "id": "5", "title": "5 — Neutro" },
              { "id": "6", "title": "6" },
              { "id": "7", "title": "7" },
              { "id": "8", "title": "8" },
              { "id": "9", "title": "9" },
              { "id": "10", "title": "10 — Com certeza!" }
            ]
          },
          {
            "type": "Footer",
            "label": "Proximo",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "COMMENT"
              },
              "payload": {
                "nps_score": "${form.nps_score}",
                "screen_source": "NPS_SCORE"
              }
            }
          }
        ]
      },
      "data": {
        "company_name": {
          "type": "string",
          "__example__": "Loja Exemplo"
        }
      }
    },
    {
      "id": "COMMENT",
      "title": "Comentario",
      "terminal": false,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Quer deixar um comentario?"
          },
          {
            "type": "TextBody",
            "text": "Opcional — conte-nos o que podemos melhorar ou o que voce mais gostou."
          },
          {
            "type": "TextArea",
            "name": "comment",
            "label": "Seu comentario (opcional)",
            "required": false,
            "helper-text": "Maximo 500 caracteres"
          },
          {
            "type": "Footer",
            "label": "Enviar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "nps_score": "${data.nps_score}",
                "comment": "${form.comment}",
                "screen_source": "COMMENT"
              }
            }
          }
        ]
      },
      "data": {
        "nps_score": {
          "type": "string",
          "__example__": "8"
        }
      }
    },
    {
      "id": "THANK_YOU",
      "title": "Obrigado!",
      "terminal": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Obrigado pela sua avaliacao!"
          },
          {
            "type": "TextBody",
            "text": "Sua opiniao e muito importante para nos. ${data.follow_up_message}"
          },
          {
            "type": "Footer",
            "label": "Fechar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "nps_score": "${data.nps_score}",
                "comment": "${data.comment}",
                "flow_completed": true
              }
            }
          }
        ]
      },
      "data": {
        "nps_score": {
          "type": "string",
          "__example__": "8"
        },
        "comment": {
          "type": "string",
          "__example__": "Otimo atendimento!"
        },
        "follow_up_message": {
          "type": "string",
          "__example__": "Ficamos felizes com sua nota!"
        }
      }
    }
  ]
}
