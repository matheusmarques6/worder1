{
  "version": "5.0",
  "data_api_version": "3.0",
  "routing_model": {
    "NPS_SCORE": ["COMMENT", "THANK_YOU"],
    "COMMENT": ["THANK_YOU"],
    "THANK_YOU": []
  },
  "screens": [
    {
      "id": "NPS_SCORE",
      "title": "Avaliação",
      "terminal": false,
      "data": {
        "customer_name": {
          "type": "string",
          "__example__": "Maria"
        },
        "order_id": {
          "type": "string",
          "__example__": "#12345"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Olá, ${data.customer_name}! 👋"
          },
          {
            "type": "TextBody",
            "text": "Referente ao pedido ${data.order_id}, em uma escala de 0 a 10, o quanto você recomendaria nossa loja para um amigo?"
          },
          {
            "type": "RadioButtonsGroup",
            "name": "nps_score",
            "label": "Sua nota",
            "required": true,
            "data-source": [
              { "id": "10", "title": "10 — Com certeza recomendaria!" },
              { "id": "9", "title": "9 — Muito provável" },
              { "id": "8", "title": "8 — Provável" },
              { "id": "7", "title": "7 — Talvez" },
              { "id": "6", "title": "6 — Pouco provável" },
              { "id": "5", "title": "5 — Neutro" },
              { "id": "4", "title": "4 — Improvável" },
              { "id": "3", "title": "3 — Muito improvável" },
              { "id": "2", "title": "2 — Quase impossível" },
              { "id": "1", "title": "1 — Não recomendaria" },
              { "id": "0", "title": "0 — Jamais recomendaria" }
            ]
          },
          {
            "type": "Footer",
            "label": "Próximo",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "COMMENT"
              },
              "payload": {
                "nps_score": "${form.nps_score}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "COMMENT",
      "title": "Comentário",
      "terminal": false,
      "data": {
        "nps_score": {
          "type": "string",
          "__example__": "8"
        },
        "prompt_text": {
          "type": "string",
          "__example__": "O que mais te agradou na sua experiência?"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Obrigado pela nota!"
          },
          {
            "type": "TextBody",
            "text": "${data.prompt_text}"
          },
          {
            "type": "TextArea",
            "name": "comment",
            "label": "Seu comentário",
            "required": false,
            "helper-text": "Compartilhe o que gostou ou o que podemos melhorar"
          },
          {
            "type": "Footer",
            "label": "Enviar Avaliação",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "action": "submit_nps",
                "nps_score": "${data.nps_score}",
                "comment": "${form.comment}",
                "screen": "COMMENT"
              }
            }
          }
        ]
      }
    },
    {
      "id": "THANK_YOU",
      "title": "Obrigado!",
      "terminal": true,
      "data": {
        "thank_you_message": {
          "type": "string",
          "__example__": "Sua avaliação é muito importante para nós!"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Obrigado! 🎉"
          },
          {
            "type": "TextBody",
            "text": "${data.thank_you_message}"
          }
        ]
      }
    }
  ]
}
